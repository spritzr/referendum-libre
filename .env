# Per-fork app identity — PUBLIC, committed. None of these values are
# secret (they all end up readable in the shipped JS bundle / native
# manifests anyway). Real secrets (signing keys, API credentials) live in
# .env.local instead — see .env.local.example and CONTRIBUTING.md.
#
# Forking this template for a different app/referendum? Replace every
# value below (see .env.example for the placeholder form) — the release
# CI check passes automatically once no __REPLACE_ME__ sentinel remains.
# See CONTRIBUTING.md ▸ "Forking for a new app".

# --- App identity (app.config.ts) ---
APP_NAME="Referendum Libre"
APP_SLUG=referendum-libre
APP_SCHEME=referendumlibre
IOS_BUNDLE_IDENTIFIER=app.referendumcitoyen.fr
ANDROID_PACKAGE=fr.referendumcitoyen.app

# --- FreedomTool / Rarimo deployment (constants/rarime-config.ts) ---
# EXPO_PUBLIC_ prefix: these are read at RUNTIME by app JS (not just at
# build time), so Metro needs to inline them into the bundle. Expo does
# this automatically for any EXPO_PUBLIC_* var — see
# https://docs.expo.dev/guides/environment-variables/
#
# The proposal/voting contract for THIS app's referendum(s) on FreedomTool.
# A fork almost always needs its own value here — see file header for the
# full trust model.
EXPO_PUBLIC_FREEDOM_TOOL_MAINNET_PROPOSAL_STATE_ADDRESS=0x9C4b84a940C9D3140a1F40859b3d4367DC8d099a
EXPO_PUBLIC_FREEDOM_TOOL_TESTNET_PROPOSAL_STATE_ADDRESS=0x4C61d7454653720DAb9e26Ca25dc7B8a5cf7065b
EXPO_PUBLIC_DEFAULT_PROPOSAL_ID_MAINNET=1
EXPO_PUBLIC_DEFAULT_PROPOSAL_ID_TESTNET=236

# --- Proposal index signing (constants/proposal-index-signing.ts) ---
# Public key only — the matching private key is a GitHub Actions secret
# (PROPOSAL_INDEX_SIGNING_KEY), never committed. See file header.
EXPO_PUBLIC_PROPOSAL_INDEX_PUBLIC_KEY_HEX=23931f71115aacd5a236ab1a28ebb011ec0dfe8e881f7040071c6fa258fc9539 # nosec: public key used to verify proposals.json

# --- Legal / contact links (constants/urls.ts) ---
EXPO_PUBLIC_LEGAL_PRIVACY_POLICY_URL=https://referendumcitoyen.fr/politique-confidentialite
EXPO_PUBLIC_LEGAL_TERMS_URL=https://referendumcitoyen.fr/conditions-generales
EXPO_PUBLIC_REFERENDUMS_BASE_URL=https://referendumcitoyen.fr/referendums/
EXPO_PUBLIC_CONTACT_EMAIL=referendumcitoyen@proton.me
EXPO_PUBLIC_ERROR_REPORT_EMAIL=referendumcitoyen@proton.me

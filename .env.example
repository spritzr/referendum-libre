# Template for `.env` (committed, PUBLIC) — this app's identity: bundle id,
# FreedomTool contract, legal URLs. None of these values are secret (they
# all end up readable in the shipped JS bundle / native manifests anyway).
#
# Forking this template for a different app/referendum? Copy this file to
# `.env` (or edit `.env` directly if it already has Referendum Libre's
# values) and replace every value below. See CONTRIBUTING.md ▸ "Forking
# for a new app". Real secrets go in `.env.local` instead — see
# `.env.local.example`.

# --- App identity (app.config.ts) ---
APP_NAME=__REPLACE_ME__
APP_SLUG=__REPLACE_ME__
APP_SCHEME=__REPLACE_ME__
IOS_BUNDLE_IDENTIFIER=__REPLACE_ME__
ANDROID_PACKAGE=__REPLACE_ME__

# --- FreedomTool / Rarimo deployment (constants/rarime-config.ts) ---
# EXPO_PUBLIC_ prefix: these are read at RUNTIME by app JS (not just at
# build time), so Metro needs to inline them into the bundle. Expo does
# this automatically for any EXPO_PUBLIC_* var — see
# https://docs.expo.dev/guides/environment-variables/
#
# The proposal/voting contract for THIS app's referendum(s) on FreedomTool.
EXPO_PUBLIC_FREEDOM_TOOL_MAINNET_PROPOSAL_STATE_ADDRESS=__REPLACE_ME__
EXPO_PUBLIC_FREEDOM_TOOL_TESTNET_PROPOSAL_STATE_ADDRESS=__REPLACE_ME__
EXPO_PUBLIC_DEFAULT_PROPOSAL_ID_MAINNET=__REPLACE_ME__
EXPO_PUBLIC_DEFAULT_PROPOSAL_ID_TESTNET=__REPLACE_ME__

# --- Proposal index signing (constants/proposal-index-signing.ts) ---
# Public key only — generate with `node scripts/generate-proposal-signing-key.mjs`.
# The matching private key goes in the PROPOSAL_INDEX_SIGNING_KEY GitHub
# Actions secret, never committed.
EXPO_PUBLIC_PROPOSAL_INDEX_PUBLIC_KEY_HEX=__REPLACE_ME__

# --- Legal / contact links (constants/urls.ts) ---
EXPO_PUBLIC_LEGAL_PRIVACY_POLICY_URL=__REPLACE_ME__
EXPO_PUBLIC_LEGAL_TERMS_URL=__REPLACE_ME__
EXPO_PUBLIC_REFERENDUMS_BASE_URL=__REPLACE_ME__
EXPO_PUBLIC_CONTACT_EMAIL=__REPLACE_ME__
EXPO_PUBLIC_ERROR_REPORT_EMAIL=__REPLACE_ME__
